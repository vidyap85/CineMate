# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Browser-exposed or server-side Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# WEATHER_API_KEY: Server-side OpenWeatherMap / Weather API key
WEATHER_API_KEY="MY_WEATHER_API_KEY"

# SLACK_CLIENT_ID & SLACK_CLIENT_SECRET: For Slack OAuth and report dispatching
SLACK_CLIENT_ID="MY_SLACK_CLIENT_ID"
SLACK_CLIENT_SECRET="MY_SLACK_CLIENT_SECRET"
SLACK_SIGNING_SECRET="MY_SLACK_SIGNING_SECRET"

# FIREBASE CONFIGURATION (Web Client SDK)
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="cinegemini-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="cinegemini-app"
VITE_FIREBASE_STORAGE_BUCKET="cinegemini-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# GOOGLE CLOUD SECRET MANAGER PROJECT ID (For production runtime)
GCP_PROJECT_ID="cinegemini-prod"

# DEDICATED GCP SERVICE ACCOUNT (Least Privilege - DO NOT use default compute account)
# Production uses Cloud Run Service Identity via Application Default Credentials (ADC).
# Local development uses ADC or service account impersonation:
#   gcloud auth application-default login --impersonate-service-account=cinepilot-backend-sa@YOUR_PROJECT_ID.iam.gserviceaccount.com
GCP_SERVICE_ACCOUNT_EMAIL="cinepilot-backend-sa@cinegemini-prod.iam.gserviceaccount.com"

# GCP_SERVICE_ACCOUNT_KEY: LAST-RESORT ONLY.
# DO NOT require or download service-account private key JSON files in production or local dev.
# Only populate if a specific legacy deployment environment cannot support ADC or Workload Identity.
GCP_SERVICE_ACCOUNT_KEY=""

